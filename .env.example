# App
PORT=3000
LOG_LEVEL=INFO

# Database
DB_PATH=./db/conversations.sqlite

# CometAPI
COMET_API_URL=https://api.cometapi.com
COMET_API_KEY=replace_me
COMET_MODEL=gpt-5-chat-latest
COMET_MAX_TOKENS=500

# ManyChat
MANYCHAT_API_URL=https://api.manychat.com
MANYCHAT_API_TOKEN=replace_me
MANYCHAT_REPLY_FLOW_INSTAGRAM=replace_with_instagram_reply_flow_ns
MANYCHAT_REPLY_FLOW_FACEBOOK=replace_with_facebook_reply_flow_ns
MANYCHAT_REPLY_FLOW_WHATSAPP=replace_with_whatsapp_reply_flow_ns
MANYCHAT_FOLLOWUP_FLOW_INSTAGRAM=replace_with_instagram_followup_flow_ns
MANYCHAT_FOLLOWUP_FLOW_FACEBOOK=replace_with_facebook_followup_flow_ns
MANYCHAT_FOLLOWUP_FLOW_WHATSAPP=replace_with_whatsapp_followup_flow_ns
# Optional backward-compatible fallback for both supported channels.
MANYCHAT_SEND_FLOW_NS=
MANYCHAT_FIELD_AI_REPLY=ai_reply
MANYCHAT_FIELD_AI_FOLLOWUP=ai_followup_reply
MANYCHAT_FIELD_HANDOFF=handoff_flag

# Optional webhook protection (set both on ManyChat and backend)
MANYCHAT_WEBHOOK_SECRET=

# Optional internal endpoint protection for /manychat-callback
INTERNAL_API_SECRET=

# Telegram admin notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=

# System prompt file path
SYSTEM_PROMPT_PATH=system_prompt.txt
FOLLOWUP_PROMPT_PATH=followup_prompt.txt
