# App
PORT=3000
LOG_LEVEL=INFO

# Database
DB_PATH=./db/conversations.sqlite

# CometAPI
COMET_API_URL=https://api.cometapi.com
COMET_API_KEY=replace_me
COMET_MODEL=gpt-5-chat-latest
COMET_MAX_TOKENS=500

# ManyChat
MANYCHAT_API_URL=https://api.manychat.com
MANYCHAT_API_TOKEN=replace_me
MANYCHAT_SEND_FLOW_NS=replace_with_send_ai_reply_flow_ns
MANYCHAT_FIELD_AI_REPLY=ai_reply
MANYCHAT_FIELD_HANDOFF=handoff_flag

# Optional webhook protection (set both on ManyChat and backend)
MANYCHAT_WEBHOOK_SECRET=

# Optional internal endpoint protection for /manychat-callback
INTERNAL_API_SECRET=

# System prompt file path
SYSTEM_PROMPT_PATH=system_prompt.txt
